
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IINET.UI.Calendar.Controls"
    xmlns:primitives="using:Avalonia.Controls.Primitives">

    <ControlTheme
        x:Key="{x:Type controls:Calendar}"
        TargetType="controls:Calendar">

        <Setter Property="Template">
            <ControlTemplate>

                <Border
                    Background="{TemplateBinding CalendarBackground}"
                    BorderBrush="{TemplateBinding CalendarBorderBrush}"
                    BorderThickness="{TemplateBinding CalendarBorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">

                    <Grid RowDefinitions="Auto,Auto,*">
                        <Border
                            Grid.Row="0"
                            Height="{TemplateBinding CalendarTopBorderThickness}"
                            Background="{TemplateBinding CalendarTopBorderBrush}"
                            CornerRadius="12,12,0,0"/>

                        <Border
                            x:Name="PART_Header"
                            Grid.Row="1"
                            Background="{TemplateBinding HeaderBackground}"
                            Padding="12,8">

                            <Grid ColumnDefinitions="40,*,40">
                                <Border
                                    x:Name="PART_PreviousButton"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="6"
                                    Focusable="True"
                                    Cursor="Hand">

                                    <TextBlock
                                        x:Name="PART_PreviousGlyph"
                                        Text="‹"
                                        FontSize="{TemplateBinding NavigationFontSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    x:Name="PART_MonthTitle"
                                    Grid.Column="1"
                                    FontSize="{TemplateBinding MonthTitleFontSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <Border
                                    x:Name="PART_NextButton"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="6"
                                    Focusable="True"
                                    Cursor="Hand">

                                    <TextBlock
                                        x:Name="PART_NextGlyph"
                                        Text="›"
                                        FontSize="{TemplateBinding NavigationFontSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                            </Grid>

                        </Border>

                        <Grid
                            Grid.Row="2"
                            Margin="12,4,12,12"
                            RowDefinitions="Auto,*">

                            <primitives:UniformGrid
                                x:Name="PART_Weekdays"
                                Grid.Row="0"
                                Columns="7"
                                Rows="1"/>

                            <primitives:UniformGrid
                                x:Name="PART_Days"
                                Grid.Row="1"
                                Columns="7"
                                Rows="6"/>

                        </Grid>

                    </Grid>

                </Border>

            </ControlTemplate>
        </Setter>

    </ControlTheme>

</ResourceDictionary>
